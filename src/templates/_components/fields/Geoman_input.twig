<div id="{{ rootId }}" class="geoman">
    <div class="geoman__wrapper">
        <div data-geoman-map class="geoman__map" style="height: {{ height }}px" role="region" aria-label="{{ 'Geometry map'|t('craft-geoman') }}"></div>
        <json-viewer id="{{ rootId }}-viewer" class="geoman__viewer" hidden></json-viewer>
    </div>
    <input type="hidden" id="{{ id }}" name="{{ name }}" data-geoman-value value="{{ value|e('html_attr') }}"{% if readOnly %} disabled{% endif %}>
    <p data-geoman-message class="warning geoman__message" role="status" aria-live="polite" hidden></p>
    <div class="geoman__tools">
        {% if not readOnly %}
            <input data-geoman-file type="file" accept=".json,.geojson,application/json,application/geo+json" hidden aria-label="{{ 'Import GeoJSON'|t('craft-geoman') }}">
        {% endif %}
        <button type="button" class="btn" data-geoman-fit disabled>
            <span class="geoman__button-icon" aria-hidden="true">{{ svg('@app/icons/solid/map.svg') }}</span>
            {{ 'Show all geometry'|t('craft-geoman') }}
        </button>
        <div class="btngroup">
            <button type="button" class="btn" data-geoman-toggle data-geoman-action
                    aria-controls="{{ rootId }}-viewer" aria-expanded="false" disabled>
                <span class="geoman__button-icon" aria-hidden="true">{{ svg('@app/icons/solid/code.svg') }}</span>
                {{ 'GeoJSON'|t('craft-geoman') }}
            </button>
            <button type="button" class="btn" data-geoman-download data-geoman-action disabled>
                <span class="geoman__button-icon" aria-hidden="true">{{ svg('@app/icons/solid/download.svg') }}</span>
                {{ 'Export'|t('craft-geoman') }}
            </button>
            {% if not readOnly %}
                <button type="button" class="btn" data-geoman-upload data-geoman-action disabled>
                    <span class="geoman__button-icon" aria-hidden="true">{{ svg('@app/icons/solid/upload.svg') }}</span>
                    {{ 'Import'|t('craft-geoman') }}
                </button>
            {% endif %}
        </div>
    </div>
    <noscript><p class="warning">{{ 'JavaScript is required to edit the map. Your saved data is preserved.'|t('craft-geoman') }}</p></noscript>
</div>
{% js %}
new Craft.GeomanField({{ namespacedRootId|json_encode|raw }}, {{ options|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }});
{% endjs %}
